@@ -0,0 +1,47 @@
+import type { Routine as DaemonRoutine } from '@warsha/client';
+import { describe, expect, it } from 'vitest';
+
+import { routineScheduleText, toRoutineRow } from './routines';
+
+const base: DaemonRoutine = {
+  id: 'routine-1',
+  name: 'Nightly build',
+  description: 'Run the build every night',
+  schedule: { cron: '0 2 * * *' },
+  state: 'idle',
+  lastRunUnix: null,
+};
+
+describe('toRoutineRow', () => {
+  it('shows a cron schedule as the expression the daemon reported', () => {
+    const row = toRoutineRow(base, 'en');
+    expect(row.schedule).toBe('0 2 * * *');
+    expect(row.name).toBe('Nightly build');
+    expect(row.description).toBe('Run the build every night');
+  });
+
+  it('renders an interval in the catalog, in both locales', () => {
+    const schedule = { intervalSeconds: 30 } as const;
+    expect(routineScheduleText(schedule, 'en')).toBe('Every 30s');
+    expect(routineScheduleText(schedule, 'ar')).toBe('كل 30 ثانية');
+  });
+
+  it('renders a manual schedule in the catalog, in both locales', () => {
+    expect(routineScheduleText('manual', 'en')).toBe('Manual');
+    expect(routineScheduleText('manual', 'ar')).toBe('يدوي');
+  });
+
+  it('maps a failed state to failed and keeps the daemon reason', () => {
+    const row = toRoutineRow({ ...base, state: { failed: 'exit code 1' } }, 'en');
+    expect(row.state).toBe('failed');
+    expect(row.reason).toBe('exit code 1');
+  });
+
+  it('passes the live states through without a reason', () => {
+    for (const state of ['idle', 'running', 'paused'] as const) {
+      const row = toRoutineRow({ ...base, state }, 'en');
+      expect(row.state).toBe(state);
+      expect(row.reason).toBeUndefined();
+    }
+  });
+});
diff --git a/apps/desktop/src/routines.ts b/apps/desktop/src/routines.ts
new file mode 100644
index 0000000..37d0770
--- /dev/null
+++ b/apps/desktop/src/routines.ts
@@ -0,0 +1,39 @@
+// The daemon's routine record → the row the Routines screen draws.
+//
+// `@warsha/client` speaks the daemon's shape (externally tagged `schedule`/`state` enums); the screen
+// speaks display strings. This adapter is the only place the two meet, so the mapping is pure and
+// testable without a socket. The schedule line stays machine text (the row renders it mono), and a
+// failed state's reason rides along as the row's tooltip instead of being thrown away.
+import type { Routine as DaemonRoutine } from '@warsha/client';
+import { t, type Locale } from '@warsha/i18n';
+
+import type { Routine as RoutineRowData } from './components/RoutineRow';
+
+/** The display line for one schedule: the cron expression, an interval, or "manual". */
+export function routineScheduleText(schedule: DaemonRoutine['schedule'], locale: Locale): string {
+  if (schedule === 'manual') return t('routines.manual', {}, locale);
+  if ('cron' in schedule) return schedule.cron;
+  return t('routines.every_seconds', { count: schedule.intervalSeconds }, locale);
+}
+
+/** One routine as the screen's row, with the failure reason kept for the row's title. */
+export function toRoutineRow(routine: DaemonRoutine, locale: Locale): RoutineRowData {
+  const schedule = routineScheduleText(routine.schedule, locale);
+  if (typeof routine.state === 'object') {
+    return {
+      id: routine.id,
+      name: routine.name,
+      description: routine.description,
+      schedule,
+      state: 'failed',
+      reason: routine.state.failed,
+    };
+  }
+  return {
+    id: routine.id,
+    name: routine.name,
+    description: routine.description,
+    schedule,
+    state: routine.state,
+  };
+}
