From b1d9368d54699a88bc9bee4e11e4a56a848b6d8c Mon Sep 17 00:00:00 2001
From: Mohamed Ashry <contact@atharapp.download>
Date: Sun, 8 Nov 2026 05:36:22 +0400
Subject: [PATCH 1/5] fix(mobile): preserve app-release.apk when publishing the
 release copy

renameReleaseApk moved app-release.apk to warsha-remote-release.apk, so a
clean assembleRelease left the W7 gate artifact path absent. Copy instead of
move: app-release.apk (the path the W7 release gates verify) now persists
alongside warsha-remote-release.apk (the friendly name docs/VERIFY.md and
docs/INSTALL.md reference). Deterministic on Windows, where File.renameTo
cannot replace an existing target.
---
 apps/mobile/android/app/build.gradle | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/apps/mobile/android/app/build.gradle b/apps/mobile/android/app/build.gradle
index d75dea6..5191f44 100644
--- a/apps/mobile/android/app/build.gradle
+++ b/apps/mobile/android/app/build.gradle
@@ -143,12 +143,14 @@ tasks.matching { it.name == "preBuild" }.configureEach {
 }
 
 // ---------------------------------------------------------------------------
-// Release output naming: warsha-remote-release.apk
+// Release output naming: warsha-remote-release.apk (a copy of app-release.apk)
 // ---------------------------------------------------------------------------
-// A plain doLast rename (not a Copy task) so Gradle task-output validation
-// does not clash with AGP's own writes into outputs/apk/release.
+// A plain doLast copy (not a Copy task) so Gradle task-output validation does
+// not clash with AGP's own writes into outputs/apk/release. app-release.apk is
+// preserved (never moved) because the W7 release gates verify that exact path,
+// while the friendly-named copy is what docs/VERIFY.md and docs/INSTALL.md use.
 def renameReleaseApk = tasks.register("renameReleaseApk") {
-    description = "Renames the signed release artifact to warsha-remote-release.apk."
+    description = "Publishes warsha-remote-release.apk as a copy of app-release.apk."
     group = "warsha"
     doLast {
         def dir = layout.buildDirectory.dir("outputs/apk/release").get().asFile
@@ -159,12 +161,10 @@ def renameReleaseApk = tasks.register("renameReleaseApk") {
                     "Expected signed artifact app-release.apk under " + dir +
                     " — did assembleRelease run?")
         }
-        if (!signed.renameTo(target)) {
-            java.nio.file.Files.copy(
-                    signed.toPath(), target.toPath(),
-                    java.nio.file.StandardCopyOption.REPLACE_EXISTING)
-        }
-        logger.lifecycle("Signed release APK: " + target)
+        java.nio.file.Files.copy(
+                signed.toPath(), target.toPath(),
+                java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+        logger.lifecycle("Signed release APK: " + target + " (kept " + signed.name + ")")
     }
 }
 
