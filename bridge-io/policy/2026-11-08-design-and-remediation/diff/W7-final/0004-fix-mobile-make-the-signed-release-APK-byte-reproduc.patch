From e422ede30795837a829e07dd1d50574a836dcf0f Mon Sep 17 00:00:00 2001
From: Mohamed Ashry <contact@atharapp.download>
Date: Sun, 8 Nov 2026 12:01:44 +0400
Subject: [PATCH 4/5] fix(mobile): make the signed release APK
 byte-reproducible

Drop AGP's encrypted dependency-metadata block (id 0x504b4453) from the APK
Signing Block and exclude Vite/workbox *.map files from syncRemoteWebAssets;
both were the only sources of per-build byte drift (the v2 signature itself is
deterministic PKCS#1 v1.5/SHA-512). Also stops shipping absolute local
build paths inside the release APK.
---
 apps/mobile/android/app/build.gradle | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/apps/mobile/android/app/build.gradle b/apps/mobile/android/app/build.gradle
index 5191f44..039ad74 100644
--- a/apps/mobile/android/app/build.gradle
+++ b/apps/mobile/android/app/build.gradle
@@ -92,6 +92,14 @@ android {
         buildConfig false
     }
 
+    // AGP otherwise injects an encrypted dependency-metadata block (id 0x504b4453)
+    // into the APK Signing Block, keyed with a fresh random session key every build,
+    // which makes otherwise identical signed APKs differ byte-for-byte.
+    dependenciesInfo {
+        includeInApk = false
+        includeInBundle = false
+    }
+
     // Pure-framework app: no androidx/Capacitor AARs are required by the
     // hardened WebView shell, so the release APK stays minimal.
 }
@@ -134,6 +142,11 @@ def syncRemoteWebAssets = tasks.register("syncRemoteWebAssets", Sync) {
     into webAssetsDir
     // Everything the Vite build emits (index.html, assets/, sw.js, icons, i18n).
     preserve { include ".gitkeep" }
+    // Source maps are a dev-only artifact: workbox writes sw.js into a fresh temp
+    // dir per build, so sw.js.map embeds a random temp path (and absolute worktree
+    // paths in its sourcesContent), making the APK unreproducible — and it leaks
+    // local filesystem paths. The precache manifest (sw.js) lists no .map entry.
+    exclude '**/*.map'
 }
 
 // AGP 9 registers variant tasks lazily, so hook them through the live
