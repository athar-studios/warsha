From 376000425b6c558435a9e26007ec3fd69e6496cb Mon Sep 17 00:00:00 2001
From: Mohamed Ashry <contact@atharapp.download>
Date: Sun, 8 Nov 2026 12:04:08 +0400
Subject: [PATCH 4/7] test(e2e): stub the 31 client methods the harness could
 not answer

RPC_METHODS grows 44 -> 75: the 17 Wave 2 names (harness/skills/plugins/
models/integrations writes, files.read) and the 14 wiring wires (routines,
backend kit, preview, run mode, preferences). Each has an rpcResult case in
the daemon's own snake_case shape, required bound arguments checked the way
serde checks them, reads answering []/null and mutations echoing the row they
acted on. No screen calls these yet, so every existing capture is unchanged.
---
 apps/desktop/e2e/harness.ts | 305 ++++++++++++++++++++++++++++++++++++
 1 file changed, 305 insertions(+)

diff --git a/apps/desktop/e2e/harness.ts b/apps/desktop/e2e/harness.ts
index 02fb3b7..df15826 100644
--- a/apps/desktop/e2e/harness.ts
+++ b/apps/desktop/e2e/harness.ts
@@ -103,12 +103,15 @@ export const RPC_METHODS = [
   'agent.state',
   'agent.turn',
   'backend.export',
