   'devices.pair-start',
   'devices.revoke',
+  'files.read',
   'files.tree',
   'gates.approve',
   'gates.changes',
@@ -116,13 +119,31 @@ export const RPC_METHODS = [
   'gates.reject',
   'handoff.apply',
   'handoff.create',
+  'harness.delete',
+  'harness.get',
+  'harness.import',
   'harness.list',
