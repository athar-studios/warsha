+    expect(
+      scanAppLengths("color: 'var(--warsha-color-text)', padding: 'var(--warsha-x, var(--warsha-y))',")
+    ).toEqual([]);
+  });
+
+  it('does not scan comments as if they rendered', () => {
+    expect(
+      scanAppLengths(['// padding: 16px used to live here', '/* @media (max-width: 800px) */'].join('\n'))
+    ).toEqual([]);
+  });
