From 34a734366dd72a1d6f5b8b64ecbae5cd58967811 Mon Sep 17 00:00:00 2001
From: Mohamed Ashry <contact@atharapp.download>
Date: Sun, 8 Nov 2026 12:08:24 +0400
Subject: [PATCH 6/7] test(ui): prove ModelPicker returns focus to the trigger
 on an outside close

---
 packages/ui/src/components/compounds.v2.test.tsx | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/packages/ui/src/components/compounds.v2.test.tsx b/packages/ui/src/components/compounds.v2.test.tsx
index d9beb9a..611e618 100644
--- a/packages/ui/src/components/compounds.v2.test.tsx
+++ b/packages/ui/src/components/compounds.v2.test.tsx
@@ -140,6 +140,16 @@ describe('ModelPicker', () => {
     expect(trigger).toHaveFocus();
   });
 
+  it('closes on an outside click and hands focus back to the trigger', () => {
+    render(<ModelPicker selectedId="deepseek-v3" options={OPTIONS} onChange={() => {}} ariaLabel="Select model" />);
+    fireEvent.click(screen.getByTestId('model-picker-trigger'));
+    expect(screen.getByRole('listbox')).toBeInTheDocument();
+
+    fireEvent.mouseDown(document.body);
+    expect(screen.queryByRole('listbox')).not.toBeInTheDocument();
+    expect(screen.getByTestId('model-picker-trigger')).toHaveFocus();
+  });
+
   it('ignores a keydown outside the picker, so the page cannot drive it', () => {
     render(<ModelPicker selectedId="deepseek-v3" options={OPTIONS} onChange={() => {}} ariaLabel="Select model" />);
     fireEvent.click(screen.getByTestId('model-picker-trigger'));
