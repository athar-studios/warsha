 .../ui/src/compounds/ModelPicker.stories.tsx  |  2 +-
 .../SettingsScopeSentence.stories.tsx         |  2 +-
 .../src/compounds/SettingsScopeSentence.tsx   | 37 +++++++++++--------
 4 files changed, 24 insertions(+), 19 deletions(-)

