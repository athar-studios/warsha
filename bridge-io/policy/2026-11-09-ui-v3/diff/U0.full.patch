+  it('forwards data-action and data-testid', () => {
+    render(
+      <TextArea
+        label="ملاحظات"
+        data-action="composer.input"
+        data-testid="notes-area"
+      />
+    );
+    expect(screen.getByTestId('notes-area')).toHaveAttribute('data-action', 'composer.input');
+  });
+});
