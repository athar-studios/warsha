+import { act, fireEvent, render, screen } from '@testing-library/react';
+import React from 'react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { Tooltip } from './Tooltip';
+
+describe('Tooltip primitive', () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('shows tooltip content on hover after delay', () => {
+    render(
+      <Tooltip content="معلومات إضافية" delayMs={400}>
+        <button type="button">زر</button>
+      </Tooltip>
+    );
+
+    const button = screen.getByRole('button', { name: 'زر' });
+    fireEvent.mouseEnter(button);
+
+    // Not visible immediately
+    expect(screen.queryByRole('tooltip')).not.toBeInTheDocument();
+
+    // Fast-forward past delay
+    act(() => {
+      vi.advanceTimersByTime(400);
+    });
+
+    const tooltip = screen.getByRole('tooltip');
+    expect(tooltip).toBeInTheDocument();
+    expect(tooltip).toHaveTextContent('معلومات إضافية');
+  });
+
+  it('closes on Escape key', () => {
+    render(
+      <Tooltip content="ملاحظة" delayMs={0}>
+        <button type="button">زر</button>
+      </Tooltip>
+    );
+
+    const button = screen.getByRole('button');
+    fireEvent.focus(button);
+
+    act(() => {
+      vi.advanceTimersByTime(10);
+    });
+
+    expect(screen.getByRole('tooltip')).toBeInTheDocument();
+
+    fireEvent.keyDown(window, { key: 'Escape' });
+    expect(screen.queryByRole('tooltip')).not.toBeInTheDocument();
+  });
+
+  it('forwards data-action and data-testid', () => {
+    render(
+      <Tooltip content="ملاحظة" data-action="test.tooltip" data-testid="test-tt">
+        <button type="button">زر</button>
+      </Tooltip>
+    );
+    expect(screen.getByTestId('test-tt')).toHaveAttribute('data-action', 'test.tooltip');
+  });
+});
diff --git a/packages/ui/src/v3/primitives/Tooltip.tsx b/packages/ui/src/v3/primitives/Tooltip.tsx
new file mode 100644
index 0000000..328a580
--- /dev/null
+++ b/packages/ui/src/v3/primitives/Tooltip.tsx
@@ -0,0 +1,110 @@
+// packages/ui/src/v3/primitives/Tooltip.tsx — Design System v3 Tooltip (DS v3 §3.1)
+// Visible on hover + focus with 400ms delay; Esc closes; text-only content.
+
+import React, { useEffect, useId, useRef, useState } from 'react';
+
+export interface TooltipProps {
+  content: string;
+  children: React.ReactElement;
+  delayMs?: number;
+  className?: string;
+  'data-action'?: string;
+  'data-testid'?: string;
+}
+
+export const Tooltip: React.FC<TooltipProps> = ({
+  content,
+  children,
+  delayMs = 400,
+  className = '',
+  'data-action': dataAction,
+  'data-testid': dataTestId,
+}) => {
+  const [open, setOpen] = useState(false);
+  const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const tooltipId = useId();
+
+  const show = () => {
+    if (timerRef.current) clearTimeout(timerRef.current);
+    timerRef.current = setTimeout(() => setOpen(true), delayMs);
+  };
+
+  const hide = () => {
+    if (timerRef.current) {
+      clearTimeout(timerRef.current);
+      timerRef.current = null;
+    }
+    setOpen(false);
+  };
+
+  useEffect(() => {
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape' && open) {
+        hide();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+      if (timerRef.current) clearTimeout(timerRef.current);
+    };
+  }, [open]);
+
+  const child = React.cloneElement(children, {
+    'aria-describedby': open ? tooltipId : children.props['aria-describedby'],
+    onMouseEnter: (e: React.MouseEvent) => {
+      children.props.onMouseEnter?.(e);
+      show();
+    },
+    onMouseLeave: (e: React.MouseEvent) => {
+      children.props.onMouseLeave?.(e);
+      hide();
+    },
+    onFocus: (e: React.FocusEvent) => {
+      children.props.onFocus?.(e);
+      show();
+    },
+    onBlur: (e: React.FocusEvent) => {
+      children.props.onBlur?.(e);
+      hide();
+    },
+  });
+
+  return (
+    <span
+      className={`w-tooltip-wrapper ${className}`.trim()}
+      style={{ display: 'inline-flex', position: 'relative' }}
+      data-action={dataAction}
+      data-testid={dataTestId}
+    >
+      {child}
+      {open && (
+        <span
+          id={tooltipId}
+          role="tooltip"
+          className="w-tooltip"
+          style={{
+            position: 'absolute',
+            insetBlockEnd: 'calc(100% + var(--w-space-2))',
+            insetInlineStart: '50%',
+            transform: 'translateX(-50%)',
+            backgroundColor: 'var(--w-text)',
+            color: 'var(--w-surface)',
+            paddingBlock: 'var(--w-space-1)',
+            paddingInline: 'var(--w-space-2)',
+            borderRadius: 'var(--w-radius-sm)',
+            fontSize: 'var(--w-font-size-xs)',
+            lineHeight: 'var(--w-line-height-xs)',
+            whiteSpace: 'nowrap',
+            zIndex: 'var(--w-layer-toast)',
+            pointerEvents: 'none',
+          }}
+        >
+          {content}
+        </span>
+      )}
+    </span>
+  );
+};
+
+Tooltip.displayName = 'Tooltip';
