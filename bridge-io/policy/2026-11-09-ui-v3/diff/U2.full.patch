+        resync_required: false,
+        dropped_count: 0,
+        run: null,
+        events: [],
+      }),
+      unsubscribeRun,
+    } as unknown as WarshaClient;
+
+    const { unmount } = renderHook(() => useRunEvents('run-1' as RunId, {}, client));
+    await act(async () => {});
+
+    unmount();
+    expect(unsubscribeRun).toHaveBeenCalledWith('run-1');
+  });
+});
