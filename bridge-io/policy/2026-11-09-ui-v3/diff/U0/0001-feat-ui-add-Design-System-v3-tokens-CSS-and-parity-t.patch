+  --w-primary-hover: #FFE04A;
+  --w-on-primary: #1B1A17;
+  --w-primary-soft: #3A3008;
+  --w-primary-text: #FFD84D;
+  --w-attention: #FF9D5C;
+  --w-attention-soft: #3D2314;
+  --w-success: #5CC98A;
+  --w-success-soft: #15301F;
+  --w-danger: #F07A70;
+  --w-danger-soft: #3A1714;
+  --w-info: #7DB0F5;
+  --w-info-soft: #152842;
+  --w-focus: #FFD400;
+  --w-scrim: #000000A3;
+
+  --w-shadow-1: 0 1px 3px rgba(0, 0, 0, 0.40);
+  --w-shadow-2: 0 4px 12px rgba(0, 0, 0, 0.50);
+  --w-shadow-overlay: 0 12px 32px rgba(0, 0, 0, 0.60);
+}
+
+/* OS Dark Preference (unless overridden by data-theme="light") */
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --w-bg: #131210;
+    --w-surface: #1B1A17;
+    --w-sunken: #24221E;
+    --w-line: #33302A;
+    --w-line-strong: #7D776C;
+    --w-text: #F1EEE7;
+    --w-text-muted: #B3AEA3;
+    --w-text-faint: #948F84;
+    --w-primary: #FFD400;
+    --w-primary-hover: #FFE04A;
+    --w-on-primary: #1B1A17;
+    --w-primary-soft: #3A3008;
+    --w-primary-text: #FFD84D;
+    --w-attention: #FF9D5C;
+    --w-attention-soft: #3D2314;
+    --w-success: #5CC98A;
+    --w-success-soft: #15301F;
+    --w-danger: #F07A70;
+    --w-danger-soft: #3A1714;
+    --w-info: #7DB0F5;
+    --w-info-soft: #152842;
+    --w-focus: #FFD400;
+    --w-scrim: #000000A3;
+
+    --w-shadow-1: 0 1px 3px rgba(0, 0, 0, 0.40);
+    --w-shadow-2: 0 4px 12px rgba(0, 0, 0, 0.50);
+    --w-shadow-overlay: 0 12px 32px rgba(0, 0, 0, 0.60);
+  }
+}
+
+/* Compact Density: switches control height 44 -> 32 and table text md -> sm */
+[data-density="compact"] {
+  --w-control-height: 32px;
+  --w-table-text-size: var(--w-font-size-sm);
+  --w-table-line-height: var(--w-line-height-sm);
+}
+
+/* Reduced Motion: motion durations collapse to 0 */
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --w-dur-fast: 0ms;
+    --w-dur: 0ms;
+    --w-dur-slow: 0ms;
+  }
+}
+
+/* RTL Icon Mirroring */
+[dir="rtl"] .w-icon--mirror {
+  transform: scaleX(-1);
+}
