+  --w-ease: cubic-bezier(.2, .8, .2, 1);
+
+  /* Layout & Density Defaults (Comfortable) */
+  --w-content-narrow: 720px;
+  --w-content: 1120px;
+  --w-content-wide: 1440px;
+  --w-nav-width: 264px;
