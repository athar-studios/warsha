+
+/* Explicit Dark Theme */
+:root[data-theme="dark"] {
+  --w-bg: #131210;
+  --w-surface: #1B1A17;
+  --w-sunken: #24221E;
+  --w-line: #33302A;
+  --w-line-strong: #7D776C;
