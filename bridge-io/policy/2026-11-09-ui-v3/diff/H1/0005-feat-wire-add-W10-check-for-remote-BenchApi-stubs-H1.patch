+const BENCH_API_TO_RPC = {
+  health: 'health',
+  listProjects: 'projects.list',
+  listRuns: 'runs.list',
+  getRunStatus: 'runs.get',
+  getGates: 'gates.list',
+  getRunLogs: 'runs.events',
