diff --git a/apps/desktop/src/v3/data/usePlugins.test.ts b/apps/desktop/src/v3/data/usePlugins.test.ts
new file mode 100644
index 0000000..85b65a9
--- /dev/null
+++ b/apps/desktop/src/v3/data/usePlugins.test.ts
@@ -0,0 +1,66 @@
+import { act, renderHook } from '@testing-library/react';
+import type { PluginDefinition, WarshaClient } from '@warsha/client';
+import { describe, expect, it, vi } from 'vitest';
+
+import { usePlugins } from './usePlugins';
+
+describe('usePlugins', () => {
+  it('handles loading state initially', () => {
+    const client = {
+      listPlugins: () => new Promise<PluginDefinition[]>(() => {}),
+    } as unknown as WarshaClient;
+
+    const { result } = renderHook(() => usePlugins(client));
+    expect(result.current.status).toBe('loading');
+    expect(result.current.data).toBeNull();
+  });
+
+  it('handles empty state when plugins list is empty', async () => {
+    const client = {
+      listPlugins: vi.fn().mockResolvedValue([]),
+    } as unknown as WarshaClient;
+
+    const { result } = renderHook(() => usePlugins(client));
+    await act(async () => {});
+
+    expect(result.current.status).toBe('empty');
+    expect(result.current.data).toEqual([]);
+  });
+
+  it('handles ready state when plugins exist', async () => {
+    const list: PluginDefinition[] = [
+      { id: 'plugin-1', name: 'github', enabled: true, tools: ['search_prs'] },
+    ];
+    const client = {
+      listPlugins: vi.fn().mockResolvedValue(list),
+    } as unknown as WarshaClient;
+
+    const { result } = renderHook(() => usePlugins(client));
+    await act(async () => {});
+
+    expect(result.current.status).toBe('ready');
+    expect(result.current.data).toEqual(list);
+  });
+
+  it('handles error state and reloads', async () => {
+    const client = {
+      listPlugins: vi.fn().mockRejectedValue(new Error('Plugins error')),
+    } as unknown as WarshaClient;
+
+    const { result } = renderHook(() => usePlugins(client));
+    await act(async () => {});
+
+    expect(result.current.status).toBe('error');
+    expect(result.current.error?.message).toBe('Plugins error');
+
+    (client.listPlugins as ReturnType<typeof vi.fn>).mockResolvedValueOnce([
+      { id: 'plugin-2', name: 'filesystem', enabled: true, tools: [] },
+    ]);
+
+    await act(async () => {
+      result.current.reload();
+    });
+
+    expect(result.current.status).toBe('ready');
+  });
+});
diff --git a/apps/desktop/src/v3/data/usePlugins.ts b/apps/desktop/src/v3/data/usePlugins.ts
new file mode 100644
index 0000000..732d88a
--- /dev/null
+++ b/apps/desktop/src/v3/data/usePlugins.ts
@@ -0,0 +1,21 @@
+import type { PluginDefinition, WarshaClient } from '@warsha/client';
+
+import { useClient } from '../app/ClientContext';
+import type { HookResult } from './types';
+import { useResource } from './useResource';
+
+export function usePlugins(
+  overrideClient?: WarshaClient | null
+): HookResult<PluginDefinition[]> {
+  const contextClient = useClient();
+  const client = overrideClient !== undefined ? overrideClient : contextClient;
+
+  return useResource<PluginDefinition[]>(
+    async () => {
+      if (!client) return [];
+      return client.listPlugins();
+    },
+    (list) => !list || list.length === 0,
+    [client]
+  );
+}
