+import { act, renderHook } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { clearToastListeners, subscribeToast, type ToastMessage } from '../app/toast';
+
+import { ALL_ACTIONS, getAction, useAction, validateActionRegistry, type ActionDef } from './index';
+
+describe('action registry and useAction', () => {
+  beforeEach(() => {
+    clearToastListeners();
+  });
+
+  it('validates action registry without throwing on clean unique actions', () => {
+    expect(() => validateActionRegistry(ALL_ACTIONS)).not.toThrow();
+  });
+
+  it('throws in dev/test when duplicate action ids exist', () => {
+    const dupes: ActionDef[] = [
+      { id: 'home.start', labelKey: 'home.start', effect: 'rpc' },
+      { id: 'home.start', labelKey: 'home.start_again', effect: 'nav' },
+    ];
+    expect(() => validateActionRegistry(dupes)).toThrow('Duplicate action id registered: "home.start"');
+  });
+
+  it('retrieves an action definition by id', () => {
+    expect(getAction('non.existent')).toBeUndefined();
+  });
+
+  it('executes useAction successfully and manages pending state', async () => {
+    const fn = vi.fn().mockResolvedValue('ok');
+    const { result } = renderHook(() => useAction<[], string>('test.action', fn));
+
+    expect(result.current.pending).toBe(false);
+    expect(result.current.error).toBeNull();
+
+    let output: string | undefined;
+    await act(async () => {
+      output = await result.current.run();
+    });
+
+    expect(output).toBe('ok');
+    expect(fn).toHaveBeenCalledTimes(1);
+    expect(result.current.pending).toBe(false);
+    expect(result.current.error).toBeNull();
+  });
+
+  it('routes action failure to toast notification and updates error state', async () => {
+    const toasts: ToastMessage[] = [];
+    const unsubscribe = subscribeToast((t) => toasts.push(t));
+
+    const fn = vi.fn().mockRejectedValue(new Error('RPC call failed'));
+    const { result } = renderHook(() => useAction('test.failing', fn));
+
+    await act(async () => {
+      await result.current.run();
+    });
+
+    expect(result.current.pending).toBe(false);
+    expect(result.current.error?.message).toBe('RPC call failed');
+    expect(toasts.length).toBe(1);
+    expect(toasts[0].type).toBe('error');
+    expect(toasts[0].message).toBe('RPC call failed');
+    expect(toasts[0].actionId).toBe('test.failing');
+
+    unsubscribe();
+  });
+});
diff --git a/apps/desktop/src/v3/actions/index.ts b/apps/desktop/src/v3/actions/index.ts
new file mode 100644
index 0000000..f1481f9
--- /dev/null
+++ b/apps/desktop/src/v3/actions/index.ts
@@ -0,0 +1,88 @@
+import { useCallback, useState } from 'react';
+
+import { notify } from '../app/toast';
+
+import { ACTIONS as benchActions } from './registry/bench';
+import { ACTIONS as frameActions } from './registry/frame';
+import { ACTIONS as homeActions } from './registry/home';
+import { ACTIONS as inboxActions } from './registry/inbox';
+import { ACTIONS as onboardingActions } from './registry/onboarding';
+import { ACTIONS as projectActions } from './registry/project';
+import { ACTIONS as projectsActions } from './registry/projects';
+import { ACTIONS as settingsActions } from './registry/settings';
+import type { ActionDef } from './types';
+
+export * from './capabilities';
+export type { ActionDef } from './types';
+
+export const ALL_ACTIONS: readonly ActionDef[] = [
+  ...frameActions,
+  ...onboardingActions,
+  ...homeActions,
+  ...projectsActions,
+  ...projectActions,
+  ...inboxActions,
+  ...benchActions,
+  ...settingsActions,
+];
+
+export function validateActionRegistry(actions: readonly ActionDef[]): void {
+  const seen = new Set<string>();
+  for (const action of actions) {
+    if (seen.has(action.id)) {
+      throw new Error(`Duplicate action id registered: "${action.id}"`);
+    }
+    seen.add(action.id);
+  }
+}
+
+if (process.env.NODE_ENV !== 'production') {
+  validateActionRegistry(ALL_ACTIONS);
+}
+
+export function getAction(id: string): ActionDef | undefined {
+  return ALL_ACTIONS.find((action) => action.id === id);
+}
+
+export interface UseActionResult<TArgs extends unknown[], TResult> {
+  run: (...args: TArgs) => Promise<TResult | undefined>;
+  pending: boolean;
+  error: Error | null;
+}
+
+export function useAction<TArgs extends unknown[] = unknown[], TResult = unknown>(
+  id: string,
+  fn?: (...args: TArgs) => Promise<TResult>
+): UseActionResult<TArgs, TResult> {
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<Error | null>(null);
+
+  const run = useCallback(
+    async (...args: TArgs): Promise<TResult | undefined> => {
+      setPending(true);
+      setError(null);
+      try {
+        if (!fn) {
+          setPending(false);
+          return undefined;
+        }
+        const result = await fn(...args);
+        setPending(false);
+        return result;
+      } catch (err) {
+        const failure = err instanceof Error ? err : new Error(String(err));
+        setError(failure);
+        setPending(false);
+        notify({
+          type: 'error',
+          message: failure.message,
+          actionId: id,
+        });
+        return undefined;
+      }
+    },
+    [id, fn]
+  );
+
+  return { run, pending, error };
+}
