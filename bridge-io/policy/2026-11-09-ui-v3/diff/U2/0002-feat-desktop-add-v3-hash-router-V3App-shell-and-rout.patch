diff --git a/apps/desktop/src/v3/app/DensityContext.tsx b/apps/desktop/src/v3/app/DensityContext.tsx
new file mode 100644
index 0000000..94530d0
--- /dev/null
+++ b/apps/desktop/src/v3/app/DensityContext.tsx
@@ -0,0 +1,84 @@
+import React, { createContext, useContext, useEffect, useMemo, useState } from 'react';
+
+export type AppMode = 'simple' | 'advanced';
+export type Density = 'comfortable' | 'compact';
+
+interface DensityContextValue {
+  mode: AppMode;
+  density: Density;
+  setMode: (mode: AppMode) => void;
+  setDensity: (density: Density) => void;
+}
+
+const DensityContext = createContext<DensityContextValue>({
+  mode: 'simple',
+  density: 'comfortable',
+  setMode: () => {},
+  setDensity: () => {},
+});
+
+export const APP_MODE_STORAGE_KEY = 'warsha.app_mode';
+
+export function readStoredAppMode(): AppMode {
+  if (typeof window === 'undefined') return 'simple';
+  try {
+    const val = window.localStorage.getItem(APP_MODE_STORAGE_KEY);
+    if (val === 'simple' || val === 'advanced') return val;
+  } catch {
+    // Ignore storage errors
+  }
+  return 'simple';
+}
+
+export interface DensityProviderProps {
+  initialMode?: AppMode;
+  initialDensity?: Density;
+  children: React.ReactNode;
+}
+
+export function DensityProvider({
+  initialMode,
+  initialDensity,
+  children,
+}: DensityProviderProps): React.ReactElement {
+  const [mode, setModeState] = useState<AppMode>(() => initialMode ?? readStoredAppMode());
+  const [density, setDensityState] = useState<Density>(() => {
+    if (initialDensity) return initialDensity;
+    return mode === 'advanced' ? 'compact' : 'comfortable';
+  });
+
+  useEffect(() => {
+    if (typeof document !== 'undefined') {
+      document.documentElement.setAttribute('data-mode', mode);
+      document.documentElement.setAttribute('data-density', density);
+    }
+    if (typeof window !== 'undefined') {
+      try {
+        window.localStorage.setItem(APP_MODE_STORAGE_KEY, mode);
+      } catch {
+        // Ignore storage errors
+      }
+    }
+  }, [mode, density]);
+
+  const setMode = (nextMode: AppMode): void => {
+    setModeState(nextMode);
+    setDensityState(nextMode === 'advanced' ? 'compact' : 'comfortable');
+  };
+
+  const value = useMemo<DensityContextValue>(
+    () => ({
+      mode,
+      density,
+      setMode,
+      setDensity: setDensityState,
+    }),
+    [mode, density]
+  );
+
+  return <DensityContext.Provider value={value}>{children}</DensityContext.Provider>;
+}
+
+export function useDensity(): DensityContextValue {
+  return useContext(DensityContext);
+}
diff --git a/apps/desktop/src/v3/app/ThemeContext.tsx b/apps/desktop/src/v3/app/ThemeContext.tsx
new file mode 100644
index 0000000..54c931c
--- /dev/null
+++ b/apps/desktop/src/v3/app/ThemeContext.tsx
@@ -0,0 +1,68 @@
+import React, { createContext, useContext, useEffect, useMemo, useState } from 'react';
+
+export type ThemeMode = 'light' | 'dark' | 'system';
+
+interface ThemeContextValue {
+  theme: ThemeMode;
+  setTheme: (theme: ThemeMode) => void;
+}
+
+const ThemeContext = createContext<ThemeContextValue>({
+  theme: 'system',
+  setTheme: () => {},
+});
+
+export const THEME_STORAGE_KEY = 'warsha.theme';
+
+export function readStoredTheme(): ThemeMode {
+  if (typeof window === 'undefined') return 'system';
+  try {
+    const val = window.localStorage.getItem(THEME_STORAGE_KEY);
+    if (val === 'light' || val === 'dark' || val === 'system') return val;
+  } catch {
+    // Ignore storage errors
+  }
+  return 'system';
+}
+
+export function applyThemeToDom(theme: ThemeMode): void {
+  if (typeof document === 'undefined') return;
+  const root = document.documentElement;
+  if (theme === 'system') {
+    const prefersDark =
+      typeof window !== 'undefined' &&
+      window.matchMedia &&
+      window.matchMedia('(prefers-color-scheme: dark)').matches;
+    root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
+  } else {
+    root.setAttribute('data-theme', theme);
+  }
+}
+
+export interface ThemeProviderProps {
+  initialTheme?: ThemeMode;
+  children: React.ReactNode;
+}
+
+export function ThemeProvider({ initialTheme, children }: ThemeProviderProps): React.ReactElement {
+  const [theme, setThemeState] = useState<ThemeMode>(() => initialTheme ?? readStoredTheme());
+
+  useEffect(() => {
+    applyThemeToDom(theme);
+    if (typeof window !== 'undefined') {
+      try {
+        window.localStorage.setItem(THEME_STORAGE_KEY, theme);
+      } catch {
+        // Ignore storage errors
+      }
+    }
+  }, [theme]);
+
+  const value = useMemo(() => ({ theme, setTheme: setThemeState }), [theme]);
+
+  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>;
+}
+
+export function useTheme(): ThemeContextValue {
+  return useContext(ThemeContext);
+}
