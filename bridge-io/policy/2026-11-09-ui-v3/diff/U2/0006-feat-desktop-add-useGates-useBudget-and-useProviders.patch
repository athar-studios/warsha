+
+import { useProviders } from './useProviders';
+
+describe('useProviders', () => {
+  it('handles loading state initially', () => {
+    const client = {
+      listProviders: () => new Promise<ProviderConfig[]>(() => {}),
+    } as unknown as WarshaClient;
