error[vulnerability]: `Debug` impls for client session values expose TLS secrets
    ┌─ /home/moe/Downloads/Warsha/.agents/worktrees/rn-a5/Cargo.lock:262:1
    │
262 │ rustls 0.21.12 registry+https://github.com/rust-lang/crates.io-index
    │ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ security vulnerability detected
    │
