{
  "name": "warsha",
  "version": "0.1.0",
  "private": true,
  "description": "Warsha — Arabic-first AI Software Factory",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:desktop": "playwright test --project=desktop",
    "visual:remote": "playwright test --project=remote",
    "arch": "node scripts/check-arch.mjs",
    "policy": "node scripts/check-engineering-policy.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,html}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.20.2",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}