# Warsha — example environment (non-secret configuration only)
#
# Copy to `.env` for local tuning. `.env`, `.env.local` and `.env.*.local` are
# git-ignored; this template is safe to commit because it holds NO secrets.
#
# Secrets are NEVER read from this file. API keys live in the OS keychain
# (CredentialsRef::Keychain) — see SECURITY.md and AGENTS.md ("Secrets only via OS
# keychain"). The provider adapters fall back to an environment variable ONLY when
# a credential is explicitly configured as CredentialsRef::EnvVar; that variable is
# listed by name below for reference and MUST be left unset here.

# ─── Logging ────────────────────────────────────────────────────────────────
# tracing subscriber filter (env-filter syntax). Binaries default to "info".
RUST_LOG=info,warsha=debug

# ─── Response caches (H-06: bounded, expiring) ──────────────────────────────
# The LLM cache reuses exact/normalized model responses; the router cache is the
# per-run in-process memo. Both are bounded by an entry count (least-recently-used
# eviction) and expire after a TTL so paid model output is never retained forever.
# Unset or unparseable values fall back to the defaults shown.

# Max entries held before LRU eviction. Default: 512
WARSHA_LLM_CACHE_MAX_ENTRIES=512
# Entry lifetime in seconds (24h) of the store clock. Default: 86400
WARSHA_LLM_CACHE_TTL_SECS=86400

# Router-quality response cache (same bounds and TTL semantics).
WARSHA_ROUTER_CACHE_MAX_ENTRIES=512
WARSHA_ROUTER_CACHE_TTL_SECS=86400

# ─── Provider retry, backoff and spend-aware concurrency (H-07) ─────────────
# Paid provider calls use bounded exponential backoff with jitter, a hard retry
# ceiling per target, a total attempt budget across the whole fallback walk, and a
# semaphore that caps how many paid calls are in flight at once. Retries and
# fallback stop when the project budget is exhausted.

# Extra attempts against a single target before falling back. Default: 2
WARSHA_PROVIDER_MAX_RETRIES=2
# Hard ceiling on paid attempts across all targets for one request. Default: 6
WARSHA_PROVIDER_MAX_TOTAL_ATTEMPTS=6
# Exponential backoff base, in milliseconds. Default: 250
WARSHA_PROVIDER_BASE_BACKOFF_MS=250
# Upper bound on a single backoff sleep, in milliseconds. Default: 8000
WARSHA_PROVIDER_MAX_BACKOFF_MS=8000
# Jitter on/off: 1 = spread retries (default), 0 = plain exponential. Default: 1
WARSHA_PROVIDER_RETRY_JITTER=1
# Max simultaneous paid provider calls in flight. Default: 4
WARSHA_PROVIDER_MAX_CONCURRENT_CALLS=4

# ─── Real-provider end-to-end test (opt-in, non-secret selectors) ───────────
# The E2E suite runs fully offline against the mock provider by default. These
# switches only SELECT a model/endpoint; they carry no key. The key is supplied at
# runtime by the harness from the OS keychain, never from this file.

# Set to 1 to run the real-model E2E path (otherwise mock). Default: unset
# WARSHA_E2E_REAL=1
# Model id to use for the real-provider E2E run (an id, not a secret). Default: unset
WARSHA_REAL_PROVIDER_MODEL=
# OpenAI-compatible base URL override for the E2E run. Default: provider default
WARSHA_REAL_PROVIDER_URL=
OPENAI_BASE_URL=
# Local Ollama endpoint used by health/catalog probes. Default: http://127.0.0.1:11434
OLLAMA_HOST=

# ─── Secrets (names for reference only — DO NOT put values here) ────────────
# Provided by the OS keychain. Listed so operators know the expected names; leave
# them unset in this file.
#   WARSHA_REAL_PROVIDER_KEY   (E2E harness only, resolved from the keychain)
#   OPENAI_API_KEY             (only if a provider is configured for env vars)
#   ANTHROPIC_API_KEY          (only if a provider is configured for env vars)
