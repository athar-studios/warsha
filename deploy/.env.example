# deploy/.env.example — template for the production environment file.
#
#   cd deploy && cp .env.example .env && chmod 0600 .env
#
# .env is NEVER committed (it is covered by the repo-root .gitignore rules
# for .env; gitleaks also scans it if you ever force-add it). Every value
# below is a placeholder; the only secret in this file is the one line you
# paste in, which is why it ships empty.

# Public hostname Caddy terminates TLS for. With a real domain + DNS A/AAAA
# record pointing at this host, Caddy obtains and renews a Let's Encrypt
# certificate automatically. Leave as `localhost` for a LAN/tailnet test
# (Caddy then uses its local CA).
WARSHA_DOMAIN=warsha.example.com

# The bare host/IP a pairing link advertises to phones — REQUIRED because
# warshad binds 0.0.0.0 in-container and cannot guess which address your
# phone should dial. No scheme, no port, no path: just the host the phone
# can reach (e.g. the DNS name, or the tailnet 100.x.y.z address).
WARSHA_ADVERTISED_HOST=

# OpenAI-compatible endpoint the pipeline calls. Default is the project's
# reference router; point it at any compatible gateway.
WARSHA_LLM_BASE_URL=https://router.sayl.site/v1

# Provider key for the endpoint above — LEAVE THIS EMPTY in version control
# and paste the real value only into the uncommitted, 0600 .env. The daemon
# receives it strictly through the container environment.
WARSHA_LLM_API_KEY=

# Model id served through the endpoint above.
WARSHA_LLM_MODEL=bzl/deepseek-v4-flash-0731free

# Comma-separated browser origins allowed to call the daemon (CORS).
# Include exactly the scheme+host you serve the PWA from.
WARSHA_ALLOWED_ORIGINS=https://warsha.example.com
