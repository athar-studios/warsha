<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing tokens are sealed with a device-bound, non-exportable
     Android Keystore key, so there is nothing meaningful (and nothing
     secret) to migrate to a new device. Backup and device-transfer are
     disabled; the user re-pairs instead. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
