{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@warsha/ui": ["../../packages/ui/src"],
      "@warsha/i18n": ["../../packages/i18n/src"],
      "@warsha/client": ["../../packages/client/src"],
      "@warsha/ui/v3": ["../../packages/ui/src/v3"],
      "@warsha/i18n/v3": ["../../packages/i18n/src/v3"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}